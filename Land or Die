local ToggleTab = Window:CreateTab("Toggle", nil)

local radioToggled = false
local talkToggled = false

ToggleTab:CreateToggle({
   Name = "Loop Radio ATC (1 Detik)",
   CurrentValue = false,
   Flag = "LoopRadioATC_Toggle",
   Callback = function(Value)
      radioToggled = Value
      
      if radioToggled then
         task.spawn(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local TooltipAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TooltipAction")
            
            while radioToggled do
               local args = {
                  "Radio",
                  workspace:WaitForChild("Plane"):WaitForChild("Cockpit"):WaitForChild("ATCButton")
               }
               TooltipAction:FireServer(unpack(args))
               task.wait(1)
            end
         end)
      end
   end,
})

ToggleTab:CreateToggle({
   Name = "Auto Talk All Passengers",
   CurrentValue = false,
   Flag = "AutoTalkPassengers_Toggle",
   Callback = function(Value)
      talkToggled = Value
      
      if talkToggled then
         task.spawn(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local TooltipAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TooltipAction")
            local PassengersFolder = workspace:WaitForChild("Plane"):WaitForChild("Passengers")
            
            while talkToggled do
               for i = 1, 6 do
                  if not talkToggled then break end
                  
                  local passengerObj = PassengersFolder:FindFirstChild("Passenger_" .. i)
                  if passengerObj then
                     local args = {
                        "Talk to Passenger",
                        passengerObj
                     }
                     TooltipAction:FireServer(unpack(args))
                  end
                  
                  task.wait(1)
               end
            end
         end)
      end
   end,
})
