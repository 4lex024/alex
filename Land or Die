ButtonTab:CreateButton({
   Name = "Fix Windows",
   Callback = function()
      local ReplicatedStorage = game:GetService("ReplicatedStorage")
      local TooltipAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TooltipAction")
      local windowsFolder = workspace:WaitForChild("Plane"):WaitForChild("Windows")
      
      -- Iterasi melalui semua anak (window) yang ada di folder Windows
      for _, window in ipairs(windowsFolder:GetChildren()) do
         -- Cek apakah window memiliki child/objek bernama "Air"
         if window:FindFirstChild("Air") then
            local args = {
               "fix_window",
               window
            }
            TooltipAction:FireServer(unpack(args))
         end
      end
   end,
})

ButtonTab:CreateButton({
   Name = "Feed Passengers",
   Callback = function()
      local ReplicatedStorage = game:GetService("ReplicatedStorage")
      local TooltipAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TooltipAction")
      local passengersFolder = workspace:WaitForChild("Plane"):WaitForChild("Passengers")
      
      for i = 1, 6 do
         local passenger = passengersFolder:FindFirstChild("Passenger_" .. i)
         if passenger then
            -- Mencari objek Bar di dalam path yang ditentukan
            local bar = passenger:FindFirstChild("HumanoidRootPart")
               and passenger.HumanoidRootPart:FindFirstChild("Health")
               and passenger.HumanoidRootPart.Health:FindFirstChild("BarHolder")
               and passenger.HumanoidRootPart.Health.BarHolder:FindFirstChild("Bar")
            
            -- Memeriksa apakah skala X kurang dari atau sama dengan 0.4
            if bar and bar.Size.X.Scale <= 0.4 then
               local args = {
                  "Feed",
                  passenger
               }
               TooltipAction:FireServer(unpack(args))
            end
         end
      end
   end,
})

