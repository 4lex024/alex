-- 2. Fungsi Perekam Log
local function addLog(name, logType, generatedCode, rawPath)
    local logButton = Instance.new("TextButton")
    logButton.Size = UDim2.new(1, 0, 0, 25)
    logButton.BackgroundColor3 = Color3.fromRGB(35, 38, 43)
    logButton.BorderSizePixel = 0
    logButton.Text = "  " .. name
    logButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    logButton.TextSize = 12
    logButton.Font = Enum.Font.SourceSans
    logButton.TextXAlignment = Enum.TextXAlignment.Left
    logButton.Parent = LogList

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 6, 1, 0)
    
    if logType == "RemoteEvent" then
        indicator.BackgroundColor3 = Color3.fromRGB(230, 200, 30)
    elseif logType == "RemoteFunction" then
        indicator.BackgroundColor3 = Color3.fromRGB(230, 100, 30)
    else
        indicator.BackgroundColor3 = Color3.fromRGB(30, 150, 230)
    end
    
    indicator.BorderSizePixel = 0
    indicator.Parent = logButton

    logButton.MouseButton1Click:Connect(function()
        CodeText.Text = generatedCode
        selectedCode = generatedCode
        selectedRemotePath = rawPath
    end)
    
    LogList.CanvasSize = UDim2.new(0, 0, 0, LogLayout.AbsoluteContentSize.Y)
end

-- 3. DETEKSI: ProximityPrompt (Interact E)
ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player == game:GetService("Players").LocalPlayer then
        local promptPath = "game." .. prompt:GetFullName()
        local code = string.format("local prompt = %s\nfireproximityprompt(prompt)", promptPath)
        addLog("PP / " .. prompt.Parent.Name, "Proximity", code, promptPath)
    end
end)

-- 4. CORE DETECTOR: Format Generator
local function processRemote(remote, method, args)
    local remotePath = "game." .. remote:GetFullName()
    local isEvent = remote:IsA("RemoteEvent")
    
    local argString = ""
    if #args > 0 then
        for i, v in ipairs(args) do
            local val = tostring(v)
            if type(v) == "string" then 
                val = '"' .. v .. '"' 
            elseif type(v) == "table" then
                val = "{}"
            end
            argString = argString .. "    " .. val .. ",\n"
        end
    end
    
    local code = ""
    if isEvent then
        code = string.format("local args = {\n%s}\n%s:FireServer(unpack(args))", argString, remotePath)
        addLog("RE / " .. remote.Name, "RemoteEvent", code, remotePath)
    else
        code = string.format("local args = {\n%s}\n%s:InvokeServer(unpack(args))", argString, remotePath)
        addLog("RF / " .. remote.Name, "RemoteFunction", code, remotePath)
    end
end

-- 5. DOUBLE HOOK (__namecall & __index) agar melacak 100% data layaknya SimpleSpy Asli
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        processRemote(self, method, args)
    end
    return oldNamecall(self, ...)
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if (key == "FireServer" or key == "fireServer" or key == "InvokeServer" or key == "invokeServer") and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        return function(_, ...)
            processRemote(self, key, {...})
            return oldIndex(self, key)(self, ...)
        end
    end
    return oldIndex(self, key)
end)

