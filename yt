local Tab = Window:CreateTab("Tab Example", 4483362458) -- Title, Image

local Toggle = Tab:CreateToggle({
    Name = "Log Server Money Events",
    CurrentValue = false,
    Flag = "Toggle1", 
    Callback = function(Value)
        _G.DetectMoney = Value
        
        if _G.DetectMoney then
            print("[Spy] Mulai memantau event dari server...")
            
            -- Mengaitkan hook ke semua RemoteEvent di dalam game
            local runService = game:GetService("RunService")
            local players = game:GetService("Players")
            local localPlayer = players.LocalPlayer

            -- Cari semua RemoteEvent di game dan pasang deteksi
            for _, desc in ipairs(game:GetDescendants()) do
                if desc:IsA("RemoteEvent") then
                    pcall(function()
                        desc.OnClientEvent:Connect(function(...)
                            if not _G.DetectMoney then return end
                            
                            local args = {...}
                            local isMoneyEvent = false
                            
                            -- Analisis argumen untuk mendeteksi indikasi uang
                            for i, arg in ipairs(args) do
                                local argStr = tostring(arg):lower()
                                -- Cek kata kunci umum sistem uang game Roblox
                                if argStr:find("cash") or argStr:find("money") or argStr:find("coin") or argStr:find("yen") or argStr:find("gold") then
                                    isMoneyEvent = true
                                end
                            end
                            
                            -- Jika terdeteksi, cetak detailnya ke Developer Console (F9)
                            if isMoneyEvent then
                                print("---------------------------------------------")
                                print("[MONEY EVENT DETECTED]")
                                print("Remote Path: " .. desc:GetFullName())
                                print("Arguments:")
                                for i, arg in ipairs(args) do
                                    print(string.format("  [%d]: %s (%s)", i, tostring(arg), type(arg)))
                                end
                                print("---------------------------------------------")
                            end
                        end)
                    end)
                end
            end
        else
            print("[Spy] Pemantauan dihentikan.")
        end
    end,
})

local Toggle = Tab:CreateToggle({
   Name = "Auto Spam Minutes",
   CurrentValue = false,
   Flag = "ToggleSpamMinutes",
   Callback = function(Value)
       _G.AutoMinutes = Value
       
       if _G.AutoMinutes then
           local remote = game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvents") 
               and game:GetService("ReplicatedStorage").RemoteEvents:FindFirstChild("BarHandler")
           
           if not remote then
               Rayfield:Notify({
                  Name = "Error",
                  Content = "Remote BarHandler tidak ditemukan.",
                  Duration = 3,
                  Image = 4483362458,
               })
               return
           end

           -- Mulai loop spam selama toggle aktif
           task.spawn(function()
               while _G.AutoMinutes do
                   pcall(function()
                       local localPlayer = game:GetService("Players").LocalPlayer
                       local character = localPlayer.Character
                       local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                       
                       -- Deteksi otomatis kursi yang sedang diduduki player
                       if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("Seat") then
                           local currentSeat = humanoid.SeatPart
                           
                           -- Mencari objek Bar terdekat di sekitar kursi tersebut
                           local currentBar = nil
                           if currentSeat.Parent:FindFirstChild("Bar") then
                               currentBar = currentSeat.Parent.Bar
                           else
                               -- Jika tidak ada di parent langsung, cari objek terdekat bernama Bar
                               for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
                                   if obj.Name == "Bar" and obj:IsA("BasePart") then
                                       currentBar = obj
                                       break
                                   end
                               end
                           end
                           
                           if currentBar then
                               -- Kirim data ke server jika kursi dan bar sudah valid
                               remote:FireServer(currentBar, 3, currentSeat, "Collect")
                           end
                       end
                   end)
                   task.wait(0.5) -- Jeda pengiriman (0.5 detik)
               end
           end)
       end
   end,
})
