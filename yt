-- 2. Fungsi Pembuat Log
local function addLog(name, logType, generatedCode)
    local logButton = Instance.new("TextButton")
    logButton.Size = UDim2.new(1, 0, 0, 25)
    logButton.BackgroundColor3 = Color3.fromRGB(35, 38, 43)
    logButton.BorderSizePixel = 0
    logButton.Text = "  " .. name
    logButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    logButton.TextSize = 11
    logButton.Font = Enum.Font.SourceSans
    logButton.TextXAlignment = Enum.TextXAlignment.Left
    logButton.Parent = LogList

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 6, 1, 0)
    indicator.BackgroundColor3 = logType == "RemoteEvent" and Color3.fromRGB(230, 200, 30) or Color3.fromRGB(230, 100, 30)
    indicator.BorderSizePixel = 0
    indicator.Parent = logButton

    logButton.MouseButton1Click:Connect(function()
        CodeText.Text = generatedCode
        selectedCode = generatedCode
    end)
    
    LogList.CanvasSize = UDim2.new(0, 0, 0, LogLayout.AbsoluteContentSize.Y)
end

-- 3. Fungsi Pembersih Jalur Karakter Khusus ["/"]
local function getCleanPath(instance)
    local parts = {}
    local current = instance
    while current and current ~= game do
        local name = current.Name
        if string.find(name, "[^%w_]") then
            table.insert(parts, 1, string.format('["%s"]', name))
        else
            table.insert(parts, 1, "." .. name)
        end
        current = current.Parent
    end
    local fullPath = "game"
    for _, part in ipairs(parts) do
        fullPath = fullPath .. part
    end
    return fullPath
end

-- 4. Generator Format Pengubah Argumen
local function formatArgs(args)
    local argString = ""
    for i, v in ipairs(args) do
        local val = tostring(v)
        if type(v) == "string" then 
            val = '"' .. v .. '"' 
        elseif type(v) == "table" then
            val = "{}"
        end
        argString = argString .. "    " .. val .. ",\n"
    end
    return argString
end

-- 5. PEREKATAN AGRESIF: Hook langsung ke Method Instance Asli (Bypass Metatable)
local oldFireServer
oldFireServer = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
    local args = {...}
    task.spawn(function()
        local cleanPath = getCleanPath(self)
        local code = string.format("local args = {\n%s}\n%s:FireServer(unpack(args))", formatArgs(args), cleanPath)
        addLog(self.Name, "RemoteEvent", code)
    end)
    return oldFireServer(self, ...)
end)

