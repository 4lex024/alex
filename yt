-- 3. Fungsi Pembersih Jalur Objek (Mencegah Error akibat karakter "/")
local function getCleanPath(instance)
    local parts = {}
    local current = instance
    
    while current and current ~= game do
        local name = current.Name
        -- Bungkus dengan format string jika nama memiliki karakter non-alfanumerik seperti "/"
        if string.find(name, "[^%w_]") then
            table.insert(parts, 1, string.format('["%s"]', name))
        else
            table.insert(parts, 1, "." .. name)
        end
        current = current.Parent
    end
    
    local fullPath = "game"
    for _, part in ipairs(parts) do
        if string.sub(part, 1, 1) == "[" then
            fullPath = fullPath .. part
        else
            fullPath = fullPath .. part
        end
    end
    return fullPath
end

-- 4. Pengolah Sinyal Remote
local function processRemote(remote, method, args)
    local cleanPath = getCleanPath(remote)
    local isEvent = remote:IsA("RemoteEvent")
    
    local argString = ""
    if #args > 0 then
        for i, v in ipairs(args) do
            local val = tostring(v)
            if type(v) == "string" then 
                val = '"' .. v .. '"' 
            elseif type(v) == "table" then
                val = "{}" 
            end
            argString = argString .. "    " .. val .. ",\n"
        end
    end
    
    local code = ""
    if isEvent then
        code = string.format("local args = {\n%s}\n%s:FireServer(unpack(args))", argString, cleanPath)
        addLog(remote.Name, "RemoteEvent", code)
    else
        code = string.format("local args = {\n%s}\n%s:InvokeServer(unpack(args))", argString, cleanPath)
        addLog(remote.Name, "RemoteFunction", code)
    end
end

-- 5. Perekatan Metamethod Tingkat Tinggi (__namecall & __index)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        processRemote(self, method, args)
    end
    return oldNamecall(self, ...)
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if (key == "FireServer" or key == "fireServer" or key == "InvokeServer" or key == "invokeServer") and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        return function(_, ...)
            processRemote(self, key, {...})
            return oldIndex(self, key)(self, ...)
        end
    end
    return oldIndex(self, key)
end)

