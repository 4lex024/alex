--- [ VARIABEL KONTROL (DEFAULT OFF) ] ---

local AimbotEnabled = false
local WallCheckEnabled = false
local PartyCheckEnabled = false
local ArcadeCheckEnabled = false
local ESPEnabled = false
local InstantPromptEnabled = false
local FOVRadius = 150

--- [ FUNGSI DUAL-MODE TEAM CHECK ] ---

local function IsEnemy(targetPlayer)
    if not targetPlayer then return false end

    -- 1. Cek Mode Party (jika aktif)
    if PartyCheckEnabled then
        local myParty = Player:GetAttribute("Party")
        local targetParty = targetPlayer:GetAttribute("Party")

        if myParty ~= nil and targetParty ~= nil then
            if tostring(myParty) == tostring(targetParty) then
                return false -- Satu Party = Teman
            end
        end
    end

    -- 2. Cek Mode Arcade / Roblox Team (jika aktif)
    if ArcadeCheckEnabled then
        if Player.Team ~= nil and targetPlayer.Team ~= nil then
            if Player.Team == targetPlayer.Team then
                return false -- Satu Tim Roblox = Teman
            end
        elseif Player.TeamColor ~= nil and targetPlayer.TeamColor ~= nil then
            if Player.TeamColor == targetPlayer.TeamColor then
                return false -- Warna Tim Sama = Teman
            end
        end
    end

    -- Jika kedua mode OFF atau tidak terdeteksi sama = Musuh
    return true
end

--- [ FUNGSI WALL CHECK ] ---

local function IsVisible(targetHead)
    if not WallCheckEnabled then return true end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {}
    if Player.Character then table.insert(ignoreList, Player.Character) end
    if targetHead.Parent then table.insert(ignoreList, targetHead.Parent) end
    raycastParams.FilterDescendantsInstances = ignoreList

    local origin = Camera.CFrame.Position
    local direction = targetHead.Position - origin
    local result = workspace:Raycast(origin, direction, raycastParams)

    return result == nil
end

--- [ FUNGSI SEARCH TARGET AIMBOT ] ---

local function GetClosestTarget(screenCenter)
    local closestHead = nil
    local closestDist = FOVRadius
    
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        for _, v in pairs(Players:GetPlayers()) do
            -- Filter: Bukan diri sendiri & Harus Musuh (berdasarkan logika IsEnemy)
            if v ~= Player and IsEnemy(v) and v.Character and v.Character:FindFirstChild("Head") then
                local humanoid = v.Character:FindFirstChildOfClass("Humanoid")
                local head = v.Character.Head
                
                if humanoid and humanoid.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local distToCenter = (screenPos2D - screenCenter).Magnitude
                        
                        if distToCenter < closestDist and IsVisible(head) then
                            closestDist = distToCenter
                            closestHead = head
                        end
                    end
                end
            end
        end
    end
    
    return closestHead
end

--- [ FUNGSI HIGHLIGHT ESP ] ---

local function UpdateHighlight(targetPlayer)
    if targetPlayer == Player then return end

    local character = targetPlayer.Character
    if not character then return end

    local highlight = character:FindFirstChild("FlickHighlight")

    if ESPEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "FlickHighlight"
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = character
        end

        if IsEnemy(targetPlayer) then
            highlight.FillColor = Color3.fromRGB(255, 0, 0)      -- Merah = Musuh
            highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
        else
            highlight.FillColor = Color3.fromRGB(0, 255, 0)      -- Hijau = Teman
            highlight.OutlineColor = Color3.fromRGB(50, 255, 50)
        end
    else
        if highlight then
            highlight:Destroy()
        end
    end
end

