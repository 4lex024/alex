    local DEFAULT_ACCENT = Color3.fromRGB(0, 170, 255)

    -- Floating Toggle Button (Ukuran DIPERKECIL: 70x24, Teks DIPERBESAR: 15)
    local FloatingBtn = Instance.new("TextButton")
    FloatingBtn.Name = "FloatingHideBtn"
    FloatingBtn.Size = UDim2.new(0, 70, 0, 24)
    FloatingBtn.Position = Config.FloatingPosition
    FloatingBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    FloatingBtn.Text = "HIDE"
    FloatingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    FloatingBtn.Font = Enum.Font.SourceSansBold
    FloatingBtn.TextSize = 15
    FloatingBtn.Visible = Config.ShowFloatingBtn
    FloatingBtn.Parent = ScreenGui

    local FloatingCorner = Instance.new("UICorner")
    FloatingCorner.CornerRadius = UDim.new(1, 0)
    FloatingCorner.Parent = FloatingBtn

    local FloatingStroke = Instance.new("UIStroke")
    FloatingStroke.Color = Color3.fromRGB(80, 80, 80)
    FloatingStroke.Thickness = 1
    FloatingStroke.Parent = FloatingBtn

    -- Logika Geser (Dragging) & Perbaikan Bug Klik Cepat / Terkunci
    local isDragging = false
    local dragInput, dragStart, startPos
    local hasMoved = false

    FloatingBtn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            -- Jika posisi terkunci, abaikan proses drag sama sekali agar tombol tetap murni bisa diklik
            if not Config.LockFloatingBtn then
                isDragging = true
                hasMoved = false
                dragStart = input.Position
                startPos = FloatingBtn.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        isDragging = false
                    end
                end)
            end
        end
    end)

    FloatingBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input == dragInput and not Config.LockFloatingBtn then
            local delta = input.Position - dragStart
            if delta.Magnitude > 3 then
                hasMoved = true
            end
            FloatingBtn.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
            Config.FloatingPosition = FloatingBtn.Position
        end
    end)

    -- Animation Logic
    local isBusy = false
    local function ToggleGUI(show)
        if isBusy then return end
        isBusy = true
        if show == nil then show = not MainFrame.Visible end

        if show then
            MainFrame.Visible = true
            MainFrame.Size = smallSize
            MainFrame.Position = centerPos
            local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = normalSize, Position = normalPos
            })
            tweenPos:Play()
            tweenPos.Completed:Wait()
        else
            local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = smallSize, Position = centerPos
            })
            tweenPos:Play()
            tweenPos.Completed:Wait()
            MainFrame.Visible = false
        end
        isBusy = false
    end

    -- Tombol dijamin responsif klik meskipun digeser cepat atau dikunci
    FloatingBtn.MouseButton1Click:Connect(function()
        if not hasMoved then
            ToggleGUI()
        end
        hasMoved = false -- Reset status geser setelah klik selesai
    end)

