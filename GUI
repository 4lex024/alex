        -- 2. CreateToggle (SUDAH DIPERBAIKI UNTUK KEYBIND :Set / :SetValue)
        function TabElements:CreateToggle(opts)
            local toggleName = opts.Name or "Toggle"
            local defaultState = opts.CurrentValue or opts.Default or false
            local callback = opts.Callback or function() end
            local flag = opts.Flag or toggleName

            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -5, 0, 36)
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            ToggleFrame.Parent = Page

