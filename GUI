local Library = {}

-- Services
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Setup Global Temp Config (In-Memory RAM)
getgenv()._4LEX_TEMP_CONFIG = getgenv()._4LEX_TEMP_CONFIG or {
    ToggleKey = "K",
    GuiOpacity = 0,
    ThemeColor = {15, 15, 15},
    Toggles = {},
    Sliders = {},
    Keybinds = {}
}

local Config = getgenv()._4LEX_TEMP_CONFIG
local GUI_NAME = "4lex_024_GUI"

function Library:CreateWindow(options)
    options = options or {}
    local TitleText = options.Name or "4lex_024"
    local DefaultKey = options.ToggleKey or "K"
    
    if Config.ToggleKey == "K" and DefaultKey ~= "K" then
        Config.ToggleKey = DefaultKey
    end
    local toggleKey = Enum.KeyCode[Config.ToggleKey] or Enum.KeyCode.K

    -- Anti-Double Execute
    local existingGui = PlayerGui:FindFirstChild(GUI_NAME)
    if existingGui then existingGui:Destroy() end

    -- ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = GUI_NAME
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = PlayerGui

    -- Main Sizes
    local normalSize = UDim2.new(0, 520, 0, 340)
    local normalPos = UDim2.new(0.5, -260, 0.5, -170)
    local smallSize = UDim2.new(0, 0, 0, 0)
    local centerPos = UDim2.new(0.5, 0, 0.5, 0)

    -- Main Frame
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = smallSize
    MainFrame.Position = centerPos
    MainFrame.BackgroundColor3 = Color3.fromRGB(Config.ThemeColor[1], Config.ThemeColor[2], Config.ThemeColor[3])
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.ClipsDescendants = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = MainFrame

    local DEFAULT_ACCENT = Color3.fromRGB(0, 170, 255)

    -- Animation Logic
    local isBusy = false
    local function ToggleGUI(show)
        if isBusy then return end
        isBusy = true
        if show == nil then show = not MainFrame.Visible end

        if show then
            MainFrame.Visible = true
            MainFrame.Size = smallSize
            MainFrame.Position = centerPos
            local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = normalSize, Position = normalPos
            })
            tweenPos:Play()
            tweenPos.Completed:Wait()
        else
            local tweenPos = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = smallSize, Position = centerPos
            })
            tweenPos:Play()
            tweenPos.Completed:Wait()
            MainFrame.Visible = false
        end
        isBusy = false
    end

    -- Header
    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Size = UDim2.new(1, 0, 0, 40)
    Header.BackgroundTransparency = 1
    Header.Parent = MainFrame

    -- Avatar Profile
    local AvatarImage = Instance.new("ImageLabel")
    AvatarImage.Size = UDim2.new(0, 34, 0, 34)
    AvatarImage.Position = UDim2.new(0, 8, 0.5, -17)
    AvatarImage.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    AvatarImage.BorderSizePixel = 0
    AvatarImage.Parent = Header
    
    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = AvatarImage

    task.spawn(function()
        pcall(function()
            local content, isReady = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            if isReady then AvatarImage.Image = content end
        end)
    end)

    -- Title
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0, 200, 1, 0)
    Title.Position = UDim2.new(0, 50, 0, 0)
    Title.Text = TitleText
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 22
    Title.Font = Enum.Font.SourceSansBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1
    Title.Parent = Header

    -- Close Button
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -38, 0.5, -15)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    CloseBtn.Font = Enum.Font.SourceSansBold
    CloseBtn.Parent = Header

    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = CloseBtn

    -- Setting Button
    local SettingBtn = Instance.new("TextButton")
    SettingBtn.Size = UDim2.new(0, 30, 0, 30)
    SettingBtn.Position = UDim2.new(1, -74, 0.5, -15)
    SettingBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    SettingBtn.Text = "⚙️"
    SettingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SettingBtn.TextSize = 16
    SettingBtn.Parent = Header

    local SettingCorner = Instance.new("UICorner")
    SettingCorner.CornerRadius = UDim.new(0, 6)
    SettingCorner.Parent = SettingBtn

    local Divider = Instance.new("Frame")
    Divider.Size = UDim2.new(1, 0, 0, 1)
    Divider.Position = UDim2.new(0, 0, 0, 40)
    Divider.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Divider.BorderSizePixel = 0
    Divider.Parent = MainFrame

    CloseBtn.MouseButton1Click:Connect(function() ToggleGUI(false) end)

    -- Body Container
    local Body = Instance.new("Frame")
    Body.Size = UDim2.new(1, 0, 1, -41)
    Body.Position = UDim2.new(0, 0, 0, 41)
    Body.BackgroundTransparency = 1
    Body.Parent = MainFrame

    local TabContainer = Instance.new("Frame")
    TabContainer.Size = UDim2.new(0, 120, 1, -10)
    TabContainer.Position = UDim2.new(0, 5, 0, 5)
    TabContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TabContainer.BorderSizePixel = 0
    TabContainer.Parent = Body

    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabContainer

    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Padding = UDim.new(0, 5)
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Parent = TabContainer

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -135, 1, -10)
    ContentContainer.Position = UDim2.new(0, 130, 0, 5)
    ContentContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    ContentContainer.BorderSizePixel = 0
    ContentContainer.Parent = Body

    local ContentCorner = Instance.new("UICorner")
    ContentCorner.CornerRadius = UDim.new(0, 6)
    ContentCorner.Parent = ContentContainer

    -- Theme & Opacity Functions
    local function UpdateGUITheme(mainColor)
        MainFrame.BackgroundColor3 = mainColor
        local r, g, b = mainColor.R, mainColor.G, mainColor.B
        local containerColor = Color3.new(math.clamp(r + 0.03, 0, 1), math.clamp(g + 0.03, 0, 1), math.clamp(b + 0.03, 0, 1))
        TabContainer.BackgroundColor3 = containerColor
        ContentContainer.BackgroundColor3 = containerColor
        Config.ThemeColor = {math.floor(r * 255), math.floor(g * 255), math.floor(b * 255)}
    end

    local function ApplyOpacity(value)
        local alpha = value / 100
        MainFrame.BackgroundTransparency = alpha
        TabContainer.BackgroundTransparency = math.clamp(alpha + 0.1, 0, 1)
        ContentContainer.BackgroundTransparency = math.clamp(alpha + 0.1, 0, 1)
    end

    local tabs = {}
    local function HideAllPages()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            if t.Button then t.Button.TextColor3 = Color3.fromRGB(150, 150, 150) end
        end
    end

    local function CreatePage(pageName)
        local Page = Instance.new("ScrollingFrame")
        Page.Name = pageName .. "Page"
        Page.Size = UDim2.new(1, -10, 1, -10)
        Page.Position = UDim2.new(0, 5, 0, 5)
        Page.BackgroundTransparency = 1
        Page.BorderSizePixel = 0
        Page.Visible = false
        Page.ScrollBarThickness = 3
        Page.Parent = ContentContainer

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page

        return Page
    end

    -- Window Methods Container
    local Window = {}

    function Window:CreateTab(tabName)
        local Page = CreatePage(tabName)

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = tabName .. "Tab"
        TabBtn.Size = UDim2.new(1, 0, 0, 30)
        TabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = tabName
        TabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
        TabBtn.Font = Enum.Font.SourceSansBold
        TabBtn.TextSize = 14
        TabBtn.Parent = TabContainer

        local function SwitchToThisTab()
            HideAllPages()
            Page.Visible = true
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end

        TabBtn.MouseButton1Click:Connect(SwitchToThisTab)
        table.insert(tabs, {Button = TabBtn, Page = Page})

        if #tabs == 1 then SwitchToThisTab() end

        -- Tab Interactive Elements (Rayfield Style)
        local TabElements = {}

        function TabElements:CreateToggle(opts)
            local text = opts.Name or "Toggle"
            local callback = opts.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -5, 0, 36)
            Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            Frame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -65, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local SwitchTrack = Instance.new("TextButton")
            SwitchTrack.Size = UDim2.new(0, 42, 0, 22)
            SwitchTrack.Position = UDim2.new(1, -50, 0.5, -11)
            SwitchTrack.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            SwitchTrack.Text = ""
            SwitchTrack.AutoButtonColor = false
            SwitchTrack.Parent = Frame

            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = SwitchTrack

            local SwitchKnob = Instance.new("Frame")
            SwitchKnob.Size = UDim2.new(0, 16, 0, 16)
            SwitchKnob.Position = UDim2.new(0, 3, 0.5, -8)
            SwitchKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            SwitchKnob.Parent = SwitchTrack

            local KnobCorner = Instance.new("UICorner")
            KnobCorner.CornerRadius = UDim.new(1, 0)
            KnobCorner.Parent = SwitchKnob

            local enabled = Config.Toggles[text] or opts.CurrentValue or false
            
            local function UpdateToggleVisuals(state)
                local targetPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
                local targetColor = state and DEFAULT_ACCENT or Color3.fromRGB(50, 50, 50)
                TweenService:Create(SwitchKnob, TweenInfo.new(0.15), {Position = targetPos}):Play()
                TweenService:Create(SwitchTrack, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
            end

            UpdateToggleVisuals(enabled)
            if enabled then task.spawn(function() callback(true) end) end

            SwitchTrack.MouseButton1Click:Connect(function()
                enabled = not enabled
                Config.Toggles[text] = enabled
                UpdateToggleVisuals(enabled)
                callback(enabled)
            end)
        end

        function TabElements:CreateButton(opts)
            local scriptName = opts.Name or "Button"
            local callback = opts.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -5, 0, 36)
            Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            Frame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, -10, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = scriptName
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(0, 110, 0, 26)
            Btn.Position = UDim2.new(1, -118, 0.5, -13)
            Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            Btn.Text = "Execute"
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Font = Enum.Font.SourceSansBold
            Btn.TextSize = 13
            Btn.Parent = Frame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(callback)
        end

        function TabElements:CreateSlider(opts)
            local scriptName = opts.Name or "Slider"
            local min = opts.Range and opts.Range[1] or 0
            local max = opts.Range and opts.Range[2] or 100
            local default = opts.CurrentValue or min
            local callback = opts.Callback or function() end

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -5, 0, 48)
            SliderFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            SliderFrame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = SliderFrame

            local currentValue = Config.Sliders[scriptName] or default

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -20, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 4)
            Label.BackgroundTransparency = 1
            Label.Text = scriptName .. ": " .. tostring(currentValue)
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = SliderFrame

            local Bar = Instance.new("Frame")
            Bar.Size = UDim2.new(1, -20, 0, 6)
            Bar.Position = UDim2.new(0, 10, 0, 30)
            Bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            Bar.Parent = SliderFrame

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((currentValue - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = DEFAULT_ACCENT
            Fill.Parent = Bar

            if Config.Sliders[scriptName] ~= nil then task.spawn(function() callback(currentValue) end) end

            local dragging = false
            local function update(input)
                local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                Label.Text = scriptName .. ": " .. tostring(value)
                Config.Sliders[scriptName] = value
                callback(value)
            end

            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
            end)
        end

        function TabElements:CreateInput(opts)
            local scriptName = opts.Name or "Input"
            local placeholder = opts.PlaceholderText or "Ketik..."
            local callback = opts.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -5, 0, 36)
            Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            Frame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.45, -10, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = scriptName
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local InputBox = Instance.new("TextBox")
            InputBox.Size = UDim2.new(0, 120, 0, 26)
            InputBox.Position = UDim2.new(1, -128, 0.5, -13)
            InputBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            InputBox.PlaceholderText = placeholder
            InputBox.Text = ""
            InputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            InputBox.Font = Enum.Font.SourceSans
            InputBox.TextSize = 13
            InputBox.Parent = Frame

            local InputCorner = Instance.new("UICorner")
            InputCorner.CornerRadius = UDim.new(0, 4)
            InputCorner.Parent = InputBox

            InputBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then callback(InputBox.Text) end
            end)
        end

        function TabElements:CreateKeybind(opts)
            local scriptName = opts.Name or "Keybind"
            local defaultKey = opts.CurrentKeybind or Enum.KeyCode.E
            local callback = opts.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -5, 0, 36)
            Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            Frame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, -10, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = scriptName
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local savedKeyName = Config.Keybinds[scriptName] or defaultKey.Name
            local currentKey = Enum.KeyCode[savedKeyName] or defaultKey

            local KeyBtn = Instance.new("TextButton")
            KeyBtn.Size = UDim2.new(0, 110, 0, 26)
            KeyBtn.Position = UDim2.new(1, -118, 0.5, -13)
            KeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            KeyBtn.Text = currentKey.Name
            KeyBtn.TextColor3 = DEFAULT_ACCENT
            KeyBtn.Font = Enum.Font.SourceSansBold
            KeyBtn.TextSize = 13
            KeyBtn.Parent = Frame

            local KeyCorner = Instance.new("UICorner")
            KeyCorner.CornerRadius = UDim.new(0, 4)
            KeyCorner.Parent = KeyBtn

            local binding = false
            KeyBtn.MouseButton1Click:Connect(function()
                binding = true
                KeyBtn.Text = "Tekan Tombol..."
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                    KeyBtn.Text = input.KeyCode.Name
                    binding = false
                    Config.Keybinds[scriptName] = input.KeyCode.Name
                    callback(input.KeyCode)
                elseif not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                    if scriptName == "Hide/Show GUI Keybind" and input.KeyCode == toggleKey then
                        ToggleGUI()
                    end
                end
            end)
        end

        return TabElements
    end

    -- Setting Page Setup Internal
    local SettingPage = CreatePage("Settings")
    table.insert(tabs, {Button = nil, Page = SettingPage})

    SettingBtn.MouseButton1Click:Connect(function()
        HideAllPages()
        SettingPage.Visible = true
    end)

    -- Elements generator khusus Setting Page
    local SettingsTab = {Page = SettingPage}
    
    -- Register System Hide Keybind
    local KeybindFrame = Instance.new("Frame")
    KeybindFrame.Size = UDim2.new(1, -5, 0, 36)
    KeybindFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    KeybindFrame.Parent = SettingPage

    local KCorner = Instance.new("UICorner")
    KCorner.CornerRadius = UDim.new(0, 4)
    KCorner.Parent = KeybindFrame

    local KLabel = Instance.new("TextLabel")
    KLabel.Size = UDim2.new(0.5, -10, 1, 0)
    KLabel.Position = UDim2.new(0, 10, 0, 0)
    KLabel.BackgroundTransparency = 1
    KLabel.Text = "Hide/Show GUI Keybind"
    KLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    KLabel.Font = Enum.Font.SourceSans
    KLabel.TextSize = 14
    KLabel.TextXAlignment = Enum.TextXAlignment.Left
    KLabel.Parent = KeybindFrame

    local KeyBtn = Instance.new("TextButton")
    KeyBtn.Size = UDim2.new(0, 110, 0, 26)
    KeyBtn.Position = UDim2.new(1, -118, 0.5, -13)
    KeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    KeyBtn.Text = toggleKey.Name
    KeyBtn.TextColor3 = DEFAULT_ACCENT
    KeyBtn.Font = Enum.Font.SourceSansBold
    KeyBtn.TextSize = 13
    KeyBtn.Parent = KeybindFrame

    local KeyCorner = Instance.new("UICorner")
    KeyCorner.CornerRadius = UDim.new(0, 4)
    KeyCorner.Parent = KeyBtn

    local binding = false
    KeyBtn.MouseButton1Click:Connect(function()
        binding = true
        KeyBtn.Text = "Tekan..."
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if binding and input.UserInputType == Enum.UserInputType.Keyboard then
            KeyBtn.Text = input.KeyCode.Name
            binding = false
            toggleKey = input.KeyCode
            Config.ToggleKey = input.KeyCode.Name
        elseif not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == toggleKey then
                ToggleGUI()
            end
        end
    end)

    -- Apply Saved Configs
    UpdateGUITheme(Color3.fromRGB(Config.ThemeColor[1], Config.ThemeColor[2], Config.ThemeColor[3]))
    ApplyOpacity(Config.GuiOpacity)

    ToggleGUI(true)

    return Window
end

return Library
