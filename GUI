    -- Theme & Opacity Functions
    local function UpdateGUITheme(mainColor)
        MainFrame.BackgroundColor3 = mainColor
        local r, g, b = mainColor.R, mainColor.G, mainColor.B
        local containerColor = Color3.new(math.clamp(r + 0.03, 0, 1), math.clamp(g + 0.03, 0, 1), math.clamp(b + 0.03, 0, 1))
        TabContainer.BackgroundColor3 = containerColor
        ContentContainer.BackgroundColor3 = containerColor
        Config.ThemeColor = {math.floor(r * 255), math.floor(g * 255), math.floor(b * 255)}
    end

    local function ApplyOpacity(value)
        local alpha = value / 100
        MainFrame.BackgroundTransparency = alpha
        TabContainer.BackgroundTransparency = math.clamp(alpha + 0.05, 0, 1)
        ContentContainer.BackgroundTransparency = math.clamp(alpha + 0.05, 0, 1)
        Config.GuiOpacity = value
    end

    local tabs = {}
    local function HideAllPages()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            if t.Button then t.Button.TextColor3 = Color3.fromRGB(150, 150, 150) end
        end
    end

    local function CreatePage(pageName)
        local Page = Instance.new("ScrollingFrame")
        Page.Name = pageName .. "Page"
