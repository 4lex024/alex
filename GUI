    LTSwitchKnob.Size = UDim2.new(0, 16, 0, 16)
    LTSwitchKnob.Position = Config.LockFloatingBtn and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    LTSwitchKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    LTSwitchKnob.Parent = LTSwitchTrack

    local LTKnobCorner = Instance.new("UICorner")
    LTKnobCorner.CornerRadius = UDim.new(1, 0)
    LTKnobCorner.Parent = LTSwitchKnob

    TrackConnection(LTSwitchTrack.MouseButton1Click:Connect(function()
        Config.LockFloatingBtn = not Config.LockFloatingBtn
        FloatingBtn.Draggable = not Config.LockFloatingBtn
        
        local targetPos = Config.LockFloatingBtn and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local targetColor = Config.LockFloatingBtn and DEFAULT_ACCENT or Color3.fromRGB(50, 50, 50)
        TweenService:Create(LTSwitchKnob, TweenInfo.new(0.15), {Position = targetPos}):Play()
        TweenService:Create(LTSwitchTrack, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
    end))

    -- 3. Keybind Control
    local KeybindFrame = Instance.new("Frame")
    KeybindFrame.Size = UDim2.new(1, -5, 0, 36)
    KeybindFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    KeybindFrame.Parent = SettingPage

    local KCorner = Instance.new("UICorner")
    KCorner.CornerRadius = UDim.new(0, 4)
    KCorner.Parent = KeybindFrame

    local KLabel = Instance.new("TextLabel")
    KLabel.Size = UDim2.new(0.5, -10, 1, 0)
    KLabel.Position = UDim2.new(0, 10, 0, 0)
    KLabel.BackgroundTransparency = 1
    KLabel.Text = "Hide/Show GUI Keybind"
    KLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    KLabel.Font = Enum.Font.SourceSans
    KLabel.TextSize = 14
    KLabel.TextXAlignment = Enum.TextXAlignment.Left
    KLabel.Parent = KeybindFrame

    local KeyBtn = Instance.new("TextButton")
    KeyBtn.Size = UDim2.new(0, 110, 0, 26)
    KeyBtn.Position = UDim2.new(1, -118, 0.5, -13)
    KeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    KeyBtn.Text = toggleKey.Name
    KeyBtn.TextColor3 = DEFAULT_ACCENT
    KeyBtn.Font = Enum.Font.SourceSansBold
    KeyBtn.TextSize = 13
    KeyBtn.Parent = KeybindFrame

    local KeyCorner = Instance.new("UICorner")
    KeyCorner.CornerRadius = UDim.new(0, 4)
    KeyCorner.Parent = KeyBtn

    local binding = false
    TrackConnection(KeyBtn.MouseButton1Click:Connect(function()
        binding = true
        KeyBtn.Text = "Tekan..."
    end))

    TrackConnection(UserInputService.InputBegan:Connect(function(input, gpe)
        if binding and input.UserInputType == Enum.UserInputType.Keyboard then
            KeyBtn.Text = input.KeyCode.Name
            binding = false
            toggleKey = input.KeyCode
            Config.ToggleKey = input.KeyCode.Name
        elseif not gpe and not UserInputService:GetFocusedTextBox() and input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == toggleKey then
                ToggleGUI()
            end
        end
    end))

    -- 4. GUI Transparency Slider
    local OpacityFrame = Instance.new("Frame")
    OpacityFrame.Size = UDim2.new(1, -5, 0, 48)
    OpacityFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    OpacityFrame.Parent = SettingPage

    local OCorner = Instance.new("UICorner")
    OCorner.CornerRadius = UDim.new(0, 4)
    OCorner.Parent = OpacityFrame

    local OLabel = Instance.new("TextLabel")
    OLabel.Size = UDim2.new(1, -20, 0, 20)
    OLabel.Position = UDim2.new(0, 10, 0, 4)
    OLabel.BackgroundTransparency = 1
    OLabel.Text = "GUI Transparency: " .. tostring(Config.GuiOpacity) .. "%"
    OLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    OLabel.Font = Enum.Font.SourceSans
    OLabel.TextSize = 14
    OLabel.TextXAlignment = Enum.TextXAlignment.Left
    OLabel.Parent = OpacityFrame

    local OBar = Instance.new("Frame")
    OBar.Size = UDim2.new(1, -20, 0, 6)
    OBar.Position = UDim2.new(0, 10, 0, 30)
    OBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    OBar.Parent = OpacityFrame

    local OFill = Instance.new("Frame")
    OFill.Size = UDim2.new(math.clamp(Config.GuiOpacity / 100, 0, 1), 0, 1, 0)
    OFill.BackgroundColor3 = DEFAULT_ACCENT
    OFill.Parent = OBar

    local draggingO = false
    local function updateOpacity(input)
        local pos = math.clamp((input.Position.X - OBar.AbsolutePosition.X) / OBar.AbsoluteSize.X, 0, 1)
        local val = math.floor(pos * 100)
        OFill.Size = UDim2.new(pos, 0, 1, 0)
        OLabel.Text = "GUI Transparency: " .. tostring(val) .. "%"
        Config.GuiOpacity = val
        ApplyOpacity(val)
    end

    TrackConnection(OBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            draggingO = true 
            MainFrame.Draggable = false 
            updateOpacity(input) 
        end
    end))
    TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and draggingO then 
            draggingO = false 
            MainFrame.Draggable = true 
        end
    end))
    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if draggingO and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
            updateOpacity(input) 
        end
    end))

    -- 5. Theme Preset Selector
    local ThemeFrame = Instance.new("Frame")
    ThemeFrame.Size = UDim2.new(1, -5, 0, 36)
    ThemeFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    ThemeFrame.Parent = SettingPage

    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(0, 4)
    TCorner.Parent = ThemeFrame

    local TheLabel = Instance.new("TextLabel")
    TheLabel.Size = UDim2.new(0.4, -10, 1, 0)
    TheLabel.Position = UDim2.new(0, 10, 0, 0)
    TheLabel.BackgroundTransparency = 1
    TheLabel.Text = "Theme Presets"
    TheLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    TheLabel.Font = Enum.Font.SourceSans
    TheLabel.TextSize = 14
    TheLabel.TextXAlignment = Enum.TextXAlignment.Left
    TheLabel.Parent = ThemeFrame

    local themes = {
        {Name = "Dark", Color = Color3.fromRGB(15, 15, 15)},
        {Name = "Blue", Color = Color3.fromRGB(15, 20, 35)},
        {Name = "Red", Color = Color3.fromRGB(35, 15, 15)},
        {Name = "Purple", Color = Color3.fromRGB(25, 15, 35)}
    }

    local btnOffsetX = -10
    for i = #themes, 1, -1 do
        local t = themes[i]
        local TBtn = Instance.new("TextButton")
        TBtn.Size = UDim2.new(0, 50, 0, 24)
        TBtn.Position = UDim2.new(1, btnOffsetX - 50, 0.5, -12)
        TBtn.BackgroundColor3 = t.Color
        TBtn.Text = t.Name
        TBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        TBtn.Font = Enum.Font.SourceSansBold
        TBtn.TextSize = 11
        TBtn.Parent = ThemeFrame

        local TBtnCorner = Instance.new("UICorner")
        TBtnCorner.CornerRadius = UDim.new(0, 4)
        TBtnCorner.Parent = TBtn

        TrackConnection(TBtn.MouseButton1Click:Connect(function()
            UpdateGUITheme(t.Color)
        end))

        btnOffsetX = btnOffsetX - 55
    end

    -- Apply Initial Config
    UpdateGUITheme(Color3.fromRGB(Config.ThemeColor[1], Config.ThemeColor[2], Config.ThemeColor[3]))
    ApplyOpacity(Config.GuiOpacity)

    ToggleGUI(true)

    return Window
end

return Library
