            local OptionLayout = Instance.new("UIListLayout")
            OptionLayout.Padding = UDim.new(0, 4)
            OptionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            OptionLayout.Parent = OptionHolder

            local isOpen = false

            local function RefreshDropdown()
                for _, child in ipairs(OptionHolder:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, opt in ipairs(options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, -5, 0, 24)
                    OptBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    OptBtn.Text = opt
                    OptBtn.TextColor3 = (opt == currentOption) and DEFAULT_ACCENT or Color3.fromRGB(200, 200, 200)
                    OptBtn.Font = Enum.Font.SourceSans
                    OptBtn.TextSize = 13
                    OptBtn.Parent = OptionHolder

                    local OptCorner = Instance.new("UICorner")
                    OptCorner.CornerRadius = UDim.new(0, 4)
                    OptCorner.Parent = OptBtn

                    TrackConnection(OptBtn.MouseButton1Click:Connect(function()
                        currentOption = opt
                        Config.Dropdowns[dropName] = opt
                        DropBtn.Text = currentOption .. "  ▼"
                        
                        isOpen = false
                        TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -5, 0, 36)}):Play()
                        TweenService:Create(OptionHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, 0)}):Play()

                        RefreshDropdown()
                        callback(opt)
                    end))
                end
            end

            RefreshDropdown()
            if Config.Dropdowns[dropName] then task.spawn(function() callback(currentOption) end) end

            TrackConnection(DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local targetHeight = isOpen and math.min(#options * 28 + 45, 150) or 36
                local holderHeight = isOpen and (targetHeight - 45) or 0

                DropBtn.Text = currentOption .. (isOpen and "  ▲" or "  ▼")
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -5, 0, targetHeight)}):Play()
                TweenService:Create(OptionHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, holderHeight)}):Play()
            end))
        end

        return TabElements
    end

