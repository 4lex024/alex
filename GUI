            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -65, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = toggleName
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = ToggleFrame

            local SwitchTrack = Instance.new("TextButton")
            SwitchTrack.Size = UDim2.new(0, 42, 0, 22)
            SwitchTrack.Position = UDim2.new(1, -50, 0.5, -11)
            SwitchTrack.BackgroundColor3 = defaultState and DEFAULT_ACCENT or Color3.fromRGB(50, 50, 50)
            SwitchTrack.Text = ""
            SwitchTrack.AutoButtonColor = false
            SwitchTrack.Parent = ToggleFrame

            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = SwitchTrack

            local SwitchKnob = Instance.new("Frame")
            SwitchKnob.Size = UDim2.new(0, 16, 0, 16)
            SwitchKnob.Position = defaultState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            SwitchKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            SwitchKnob.Parent = SwitchTrack

            local KnobCorner = Instance.new("UICorner")
            KnobCorner.CornerRadius = UDim.new(1, 0)
            KnobCorner.Parent = SwitchKnob

            local ToggleObj = {
                Value = defaultState,
                CurrentValue = defaultState,
                Callback = callback
            }

            local function UpdateToggleState(newState, ignoreCallback)
                ToggleObj.Value = newState
                ToggleObj.CurrentValue = newState
                Config.Toggles[flag] = newState

                local targetPos = newState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
                local targetColor = newState and DEFAULT_ACCENT or Color3.fromRGB(50, 50, 50)

                TweenService:Create(SwitchKnob, TweenInfo.new(0.15), {Position = targetPos}):Play()
                TweenService:Create(SwitchTrack, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()

                if not ignoreCallback then
                    task.spawn(function()
                        callback(newState)
                    end)
                end
            end

            function ToggleObj:Set(newState, ignoreCallback)
                UpdateToggleState(newState, ignoreCallback)
            end

            function ToggleObj:SetValue(newState, ignoreCallback)
                UpdateToggleState(newState, ignoreCallback)
            end

            TrackConnection(SwitchTrack.MouseButton1Click:Connect(function()
                UpdateToggleState(not ToggleObj.Value, false)
            end))

            if defaultState then
                task.spawn(function() callback(defaultState) end)
            end

            return ToggleObj
        end

        -- 3. CreateSlider
        function TabElements:CreateSlider(opts)
            local scriptName = opts.Name or "Slider"
            local min = opts.Min or 0
            local max = opts.Max or 100
            local currentValue = Config.Sliders[scriptName] or opts.CurrentValue or opts.Default or min
            local callback = opts.Callback or function() end

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -5, 0, 48)
            SliderFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            SliderFrame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = SliderFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -20, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 4)
            Label.BackgroundTransparency = 1
            Label.Text = scriptName .. ": " .. tostring(currentValue)
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = SliderFrame

            local Bar = Instance.new("Frame")
            Bar.Size = UDim2.new(1, -20, 0, 6)
            Bar.Position = UDim2.new(0, 10, 0, 30)
            Bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            Bar.Parent = SliderFrame

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((currentValue - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = DEFAULT_ACCENT
            Fill.Parent = Bar

            if Config.Sliders[scriptName] ~= nil then task.spawn(function() callback(currentValue) end) end

            local dragging = false
            local function update(input)
                local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                Label.Text = scriptName .. ": " .. tostring(value)
                Config.Sliders[scriptName] = value
                callback(value)
            end

            TrackConnection(Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                    dragging = true 
                    MainFrame.Draggable = false 
                    update(input) 
                end
            end))
            TrackConnection(UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then 
                    dragging = false 
                    MainFrame.Draggable = true 
                end
            end))
            TrackConnection(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
                    update(input) 
                end
            end))
        end

