local pressedTemplates = {} 
local lastPositions = {} -- Menyimpan posisi frame sebelumnya untuk cek arah pergerakan

-- 2. TOGGLE AUTO PERFECT PERSIS DI POSISI TARGET
local Toggle = Tab:CreateToggle({
   Name = "Auto Perfect Minigame",
   CurrentValue = false,
   Flag = "RealAutoPerfectScaleV2", 
   Callback = function(Value)
       if Value then
           print("[AUTO] Auto Perfect aktif (Deteksi Persimpangan Posisi).")
           
           autoPerfectConnection = RunService.RenderStepped:Connect(function()
               local skillCheckGui = PlayerGui:FindFirstChild("03_SkillCheck")
               
               if skillCheckGui and skillCheckGui.Enabled then
                   local holder = skillCheckGui:FindFirstChild("Holder")
                   local objects = holder and holder:FindFirstChild("Objects")
                   local placement = objects and objects:FindFirstChild("Placement")
                   
                   if placement and objects then
                       -- Target mutlak X Scale = 0.05
                       local targetScaleX = placement.Position.X.Scale
                       
                       for _, child in ipairs(objects:GetChildren()) do
                           if child.Name == "Template" and child:IsA("GuiObject") then
                               
                               if not pressedTemplates[child] then
                                   local currentScaleX = child.Position.X.Scale
                                   local previousScaleX = lastPositions[child] or currentScaleX
                                   
                                   -- Simpan posisi saat ini untuk pengecekan frame berikutnya
                                   lastPositions[child] = currentScaleX
                                   
                                   local shouldPress = false
                                   
                                   -- Cek pergerakan arah objek ke kiri atau ke kanan
                                   if previousScaleX > currentScaleX then
                                       -- Bergerak ke kiri: memicu E jika menembus/menyentuh batas 0.05
                                       if currentScaleX <= targetScaleX then
                                           shouldPress = true
                                       end
                                   elseif previousScaleX < currentScaleX then
                                       -- Bergerak ke kanan: memicu E jika menembus/menyentuh batas 0.05
                                       if currentScaleX >= targetScaleX then
                                           shouldPress = true
                                       end
                                   else
                                       -- Jika frame pertama atau diam tepat di posisi target
                                       if math.abs(currentScaleX - targetScaleX) <= 0.01 then
                                           shouldPress = true
                                       end
                                   end
                                   
                                   if shouldPress then
                                       -- Mengunci agar kotak ini hanya bisa memicu 1 kali pencet E
                                       pressedTemplates[child] = true
                                       
                                       print(string.format("([!] PAS TARGET) Posisi Template: %.3f -> Menekan E", currentScaleX))
                                       
                                       -- Eksekusi tekan sekali tanpa spam
                                       VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                       task.wait(0.01)
                                       VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                                       
                                       break 
                                   end
                               end
                           end
                       end
                       
                       -- Bersihkan data dari objek yang sudah dihancurkan game
                       for oldChild in pairs(pressedTemplates) do
                           if not oldChild or not oldChild.Parent then
                               pressedTemplates[oldChild] = nil
                               lastPositions[oldChild] = nil
                           end
                       end
                   end
               else
                   -- Reset tabel pencatatan saat minigame selesai
                   if next(pressedTemplates) ~= nil then
                       pressedTemplates = {}
                       lastPositions = {}
                   end
               end
           end)
       else
           print("[AUTO] Auto Perfect dinonaktifkan.")
           if autoPerfectConnection then
               autoPerfectConnection:Disconnect()
               autoPerfectConnection = nil
           end
           pressedTemplates = {}
           lastPositions = {}
       end
   end,
})

