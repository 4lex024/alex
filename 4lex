-- Fungsi untuk mengeksekusi teleportasi
local function teleportToPlayer()
    if targetUsername == "" then 
        warn("Username belum dimasukkan!")
        return 
    end

    local foundPlayer = nil
    -- Mencari player yang cocok (bisa partial name/nama depan saja)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.sub(string.lower(player.Name), 1, #targetUsername) == string.lower(targetUsername) then
            foundPlayer = player
            break
        end
    end

    if foundPlayer then
        local localCharacter = LocalPlayer.Character
        local targetCharacter = foundPlayer.Character

        if localCharacter and targetCharacter then
            local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
            local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

            if localRoot and targetRoot then
                -- Teleport ke posisi target (sedikit di atasnya agar tidak nyangkut)
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
                print("Berhasil teleport ke: " .. foundPlayer.Name)
            else
                warn("HumanoidRootPart tidak ditemukan.")
            end
        else
            warn("Karakter player tidak ditemukan.")
        end
    else
        warn("Player dengan nama '" .. targetUsername .. "' tidak ditemukan.")
    end
end

