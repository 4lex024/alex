   ["AkariNM"] = true, ["AkariRage"] = true, ["Mizuno"] = true, 
   ["HogoGuntai"] = true, ["Baigai"] = true, ["AkariRageNM"] = true, 
   ["Kutsu"] = true, ["Senzai"] = true, ["MizunoNM"] = true, ["Akari"] = true
}

local function checkAndCache(obj)
   if whitelistNames[obj.Name] then
      local enemyPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
      if enemyPart then
         activeEnemies[obj] = enemyPart
      end
   end
end

