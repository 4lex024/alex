-- Loop kontrol kecepatan yang tidak menyentuh properti Humanoid.WalkSpeed
RunService.Heartbeat:Connect(function()
    if getgenv().CustomSpeed > 0 then
        local Character = Player.Character
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        
        if Humanoid and Root and Humanoid.MoveDirection.Magnitude > 0 then
            -- Menghitung arah gerak (WASD) dan mengalikan dengan kecepatan kustom
            -- Ini membuat Anda bergerak secepat angka yang dimasukkan, 
            -- tapi sistem game tetap menganggap WalkSpeed Anda normal (16)
            Root.AssemblyLinearVelocity = Vector3.new(
                Humanoid.MoveDirection.X * getgenv().CustomSpeed,
                Root.AssemblyLinearVelocity.Y, -- Tetap biarkan gravitasi bekerja pada sumbu Y
                Humanoid.MoveDirection.Z * getgenv().CustomSpeed
            )
        end
    end
end)

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

-- Fungsi Sakral untuk Mematikan dan Membersihkan Semuanya Sampai Akar
local function MatikanScriptTotal(humanoid)
   -- 1. Putuskan Loop RenderStepped jika sedang berjalan
   if _G.TPConnection then
      _G.TPConnection:Disconnect()
      _G.TPConnection = nil
   end
   
   -- 2. Hancurkan Platform Invisible jika ada
   if _G.TPPlatform then
      _G.TPPlatform:Destroy()
      _G.TPPlatform = nil
   end
   
   -- 3. Kembalikan State Humanoid ke Normal agar bisa jatuh/bergerak bebas
   if humanoid then
      humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
      humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
      humanoid:ChangeState(Enum.HumanoidStateType.Freefall) -- Paksa jatuh jika sedang melayang
   end
end

-- Otomatis matikan script versi lama saat kamu klik "Execute" ulang
local character = LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
MatikanScriptTotal(humanoid)

local InputKetinggian = Tab:CreateInput({
   Name = "Teleport Vertikal (+ Lantai Tetap)",
   CurrentValue = "",
   PlaceholderText = "Angka untuk TP / Kosongkan untuk hilangkan lantai",
   RemoveTextAfterFocusLost = false,
   Flag = "InstantTPPlatformInput",
   Callback = function(Text)
      local character = LocalPlayer.Character
      local hrp = character and character:FindFirstChild("HumanoidRootPart")
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      
      if not hrp or not humanoid then return end
      
      -- JIKA INPUT KOSONG -> MATIKAN TOTAL DAN BERSIHKAN SEMUANYA
      if Text == "" or Text == nil then
         MatikanScriptTotal(humanoid)
         return
      end
      
      -- JIKA INPUT BERUPA ANGKA (Teleport)
      local Angka = tonumber(Text)
      if Angka then
         -- Bersihkan dlu sisa loop sebelumnya sebelum membuat loop baru
         MatikanScriptTotal(humanoid)
         
         humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
         humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
         humanoid:ChangeState(Enum.HumanoidStateType.Running)
         
         _G.TPTargetY = (hrp.Position.Y + Angka) - 3.5
         hrp.CFrame = hrp.CFrame + Vector3.new(0, Angka, 0)
         
         _G.TPPlatform = Instance.new("Part")
         _G.TPPlatform.Name = "InvisibleTPFloor"
         _G.TPPlatform.Size = Vector3.new(8, 0.5, 8)
         _G.TPPlatform.Anchored = true
         _G.TPPlatform.CanCollide = true
         _G.TPPlatform.Transparency = 1
         _G.TPPlatform.Parent = workspace
         
         -- Jalankan loop baru dan simpan di global table (_G)
         _G.TPConnection = RunService.RenderStepped:Connect(function()
            -- Proteksi: Jika tiba-tiba objek dihapus di tengah jalan, loop otomatis berhenti sendiri
            if not _G.TPConnection then return end 
            
            if _G.TPPlatform and hrp and humanoid then
               _G.TPPlatform.CFrame = CFrame.new(hrp.Position.X, _G.TPTargetY, hrp.Position.Z)
               hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
               
               if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
                  humanoid:ChangeState(Enum.HumanoidStateType.Running)
               end
            else
               -- Jika salah satu object hilang (misal mati/reset), matikan loop-nya
               MatikanScriptTotal(humanoid)
            end
         end)
      end
   end
})

local Toggle = Tab:CreateToggle({
   Name = "ESP YenCoin",
   CurrentValue = false,
   Flag = "YenCoinESPFlag", 
   Callback = function(Value)
      _G.YenCoinESP = Value
      
      -- Fungsi untuk membuat Highlight pada YenCoin
      local function applyHighlight(obj)
         if obj.Name == "YenCoin" and not obj:FindFirstChild("ESPHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.FillColor = Color3.fromRGB(0, 255, 255) -- Warna Cyan/Biru Muda (bisa diganti)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- Warna Outline Putih
            highlight.OutlineTransparency = 0
            highlight.Parent = obj
         end
      end

      -- Fungsi untuk menghapus semua Highlight
      local function removeHighlight()
         for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "ESPHighlight" then
               v:Destroy()
            end
         end
      end

      if _G.YenCoinESP then
         -- Nyalakan ESP untuk objek yang sudah ada di workspace
         for _, child in pairs(workspace:GetDescendants()) do
            applyHighlight(child)
         end

         -- Nyalakan ESP untuk objek baru yang baru muncul (spawn)
         _G.YenCoinConnection = workspace.DescendantAdded:Connect(function(child)
            if _G.YenCoinESP then
               applyHighlight(child)
            end
         end)
      else
         -- Jika toggle dimatikan, matikan koneksi dan hapus highlight
         if _G.YenCoinConnection then
            _G.YenCoinConnection:Disconnect()
            _G.YenCoinConnection = nil
         end
         removeHighlight()
      end
   end,
})

-- Toggle Gabungan untuk Enemy (Warna Merah - Anti Invisible)
local ToggleGataGrunts = Tab:CreateToggle({
   Name = "ESP Enemies",
   CurrentValue = false,
   Flag = "GataGruntsESPFlag", 
   Callback = function(Value)
      _G.GataGruntsESP = Value
      
      -- Daftar nama semua objek musuh
      local targetNames = {
         ["Gata"] = true,
         ["Gata2"] = true,
         ["Grunt1"] = true,
         ["Grunt2"] = true,
         ["Grunt3"] = true,
         ["AkariNM"] = true,
         ["AkariSpider"] = true,
         ["AkariRage"] = true,
         ["Mizuno"] = true,
         ["Muki"] = true,
         ["Muki2"] = true,
         ["HogoGuntai"] = true,
         ["Baigai"] = true,
         ["MikaDies"] = true,
         ["AkariRageNM"] = true,
         ["MizunoNM"] = true
      }

      -- Fungsi untuk memasang Highlight dan mengunci transparansinya
      local function applyHighlight(obj)
         if targetNames[obj.Name] and not obj:FindFirstChild("EnemyHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "EnemyHighlight"
            highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Merah
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.OutlineTransparency = 0
            highlight.Parent = obj

            -- Loop khusus untuk memaksa Highlight tetap terlihat walaupun objek invisible
            task.spawn(function()
               while _G.GataGruntsESP and highlight and highlight.Parent do
                  if highlight.FillTransparency ~= 0.5 or highlight.OutlineTransparency ~= 0 then
                     highlight.FillTransparency = 0.5
                     highlight.OutlineTransparency = 0
                  end
                  task.wait(0.3) -- Memeriksa setiap 0.3 detik agar tidak membebani performa
               end
            end)
         end
      end

      -- Fungsi untuk menghapus semua Highlight
      local function removeHighlight()
         for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EnemyHighlight" then
               v:Destroy()
            end
         end
      end

      -- Bersihkan koneksi global sebelumnya jika ada
      if _G.GlobalEnemyConnection then 
         _G.GlobalEnemyConnection:Disconnect() 
         _G.GlobalEnemyConnection = nil 
      end

      if _G.GataGruntsESP then
         -- 1. Scan semua objek yang saat ini sudah ada
         for _, child in pairs(workspace:GetDescendants()) do
            applyHighlight(child)
         end

         -- 2. Pantau jika ada objek baru yang masuk ke workspace
         _G.GlobalEnemyConnection = workspace.DescendantAdded:Connect(function(child)
            if _G.GataGruntsESP then 
               applyHighlight(child) 
            end
         end)
      else
         removeHighlight()
      end
   end,
})
