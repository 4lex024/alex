-- IMPLEMENTASI TOGGLE FIX (RESPONSIF + ANTI-GETAR)
local Toggle = Tab:CreateToggle({
   Name = "Fly Platform (Fix Kamera + T/Q)",
   CurrentValue = false,
   Flag = "FlyPlatformToggleTQFix", 
   Callback = function(Value)
      local character = LocalPlayer.Character
      local hrp = character and character:FindFirstChild("HumanoidRootPart")
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      
      if not hrp or not humanoid then return end
      
      if not Value then
         MatikanScriptTotal(humanoid)
         return
      end
      
      MatikanScriptTotal(humanoid)
      
      humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
      humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
      humanoid:ChangeState(Enum.HumanoidStateType.Running)
      
      -- Set tinggi awal platform di bawah kaki player
      _G.TPTargetY = hrp.Position.Y - 3.5
      
      _G.TPPlatform = Instance.new("Part")
      _G.TPPlatform.Name = "InvisibleTPFloor"
      _G.TPPlatform.Size = Vector3.new(15, 0.5, 15)
      _G.TPPlatform.Anchored = true
      _G.TPPlatform.CanCollide = true
      _G.TPPlatform.Transparency = 1
      _G.TPPlatform.Parent = workspace
      
      _G.TPConnection = RunService.Heartbeat:Connect(function()
         if not _G.TPConnection then return end 
         
         if _G.TPPlatform and hrp and humanoid and Camera then
            
            -- 1. Logika Tombol Manual (T untuk naik, Q untuk turun)
            if IsPressingT then
               _G.TPTargetY = _G.TPTargetY + KecepatanTombol
            elseif IsPressingQ then
               _G.TPTargetY = _G.TPTargetY - KecepatanTombol
            
            -- 2. Logika Kamera Terbimbing (Maju/Mundur mengikuti kemiringan kamera)
            elseif humanoid.MoveDirection.Magnitude > 0 then
               local ArahKameraY = Camera.CFrame.LookVector.Y
               local ArahJalanKarakter = humanoid.MoveDirection:Dot(Camera.CFrame.LookVector)
               local MultiplierArah = ArahJalanKarakter > 0 and 1 or (ArahJalanKarakter < 0 and -1 or 0)
               
               _G.TPTargetY = _G.TPTargetY + (ArahKameraY * SensitivitasKamera * MultiplierArah)
            end
            
            -- SINKRONISASI POSISI AKTIF
            _G.TPPlatform.CFrame = CFrame.new(hrp.Position.X, _G.TPTargetY, hrp.Position.Z)
            hrp.CFrame = CFrame.new(hrp.Position.X, _G.TPTargetY + 3.5, hrp.Position.Z)
            
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
            
            if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
               humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
         else
            MatikanScriptTotal(humanoid)
         end
      end)
   end,
})

