-- Fungsi pembantu untuk mendapatkan folder berdasarkan string jalur
local function getFolderFromPath(pathString)
    local segments = string.split(pathString, ".")
    local current = game
    for _, segment in ipairs(segments) do
        if segment == "workspace" then
            current = Workspace
        else
            current = current:FindFirstChild(segment)
        end
        if not current then return nil end
    end
    return current
end

-- Fungsi untuk membuat/memperbarui ESP di tengah objek berdasarkan jarak
local function updateESP(item, character)
    if not item:IsA("BasePart") and not item:FindFirstChildWhichIsA("BasePart") then return end
    
    local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not part or not character or not character:FindFirstChild("HumanoidRootPart") then return end

    -- Hitung jarak antara player dengan item
    local distance = (character.HumanoidRootPart.Position - part.Position).Magnitude
    local existingESP = part:FindFirstChild("ItemESPText")

    -- Jarak <= 10 studs
    if distance <= 50 then
        if not existingESP then
            -- Membuat BillboardGui tepat di tengah objek
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ItemESPText"
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.AlwaysOnTop = true
            billboard.ExtentsOffset = Vector3.new(0, 0, 0) -- Pas di tengah objek
            billboard.Adornee = part
            billboard.Parent = part

            -- Membuat TextLabel
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = item.Name
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            textLabel.TextSize = 14
            textLabel.TextStrokeTransparency = 0
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.Parent = billboard

            activeTags[item] = billboard
        end
    else
        -- Jika di luar radius, hapus ESP
        if existingESP then
            existingESP:Destroy()
            activeTags[item] = nil
        end
    end
end

-- Fungsi untuk membersihkan semua ESP
local function removeAllESP()
    for item, tag in pairs(activeTags) do
        if tag then tag:Destroy() end
    end
    activeTags = {}
end

