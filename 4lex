-- FITUR 1: WALKSPEED SAFE (Menggunakan Heartbeat - Sudah Optimal)
-- =============================================================================
getgenv().CustomSpeed = 0 

local Input = Tab:CreateInput({
   Name = "Set Custom WalkSpeed (Safe)",
   CurrentValue = "",
   PlaceholderText = "Masukkan kecepatan (contoh: 20)",
   RemoveTextAfterFocusLost = false,
   Flag = "SpeedInput",
   Callback = function(Text)
      getgenv().CustomSpeed = tonumber(Text) or 0
   end,
})

RunService.Heartbeat:Connect(function()
    if getgenv().CustomSpeed > 0 then
        local Character = Player.Character
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        
        if Humanoid and Root and Humanoid.MoveDirection.Magnitude > 0 then
            Root.AssemblyLinearVelocity = Vector3.new(
                Humanoid.MoveDirection.X * getgenv().CustomSpeed,
                Root.AssemblyLinearVelocity.Y, 
                Humanoid.MoveDirection.Z * getgenv().CustomSpeed
            )
        end
    end
end)

