-- Toggle Gabungan untuk Enemy (Warna Merah - Campuran Highlight & Box ESP)
local ToggleGataGrunts = Tab:CreateToggle({
   Name = "ESP Enemies",
   CurrentValue = false,
   Flag = "GataGruntsESPFlag", 
   Callback = function(Value)
      _G.GataGruntsESP = Value
      
      -- Daftar nama semua objek musuh & titik lemah
      local targetNames = {
         ["Gata"] = true, ["Gata2"] = true, ["Grunt1"] = true, ["Grunt2"] = true, ["Grunt3"] = true,
         ["AkariNM"] = true, ["AkariSpider"] = true, ["AkariRage"] = true, ["Mizuno"] = true,
         ["Muki"] = true, ["Muki2"] = true, ["HogoGuntai"] = true, ["Baigai"] = true,
         ["AkariRageNM"] = true, ["MizunoNM"] = true, ["Akari"] = true,
         ["Tenome"] = true, ["Rin"] = true, ["Tsukiya"] = true, ["Senzai"] = true, ["Kutsu"] = true,
         ["Enzukai2"] = true, ["Rin2"] = true, ["Tenome2"] = true, ["Tsukiya2"] = true,
         ["EnzukaiRyu"] = true, ["EnzukaiWeakPoint"] = true
      }

      if not _G.ESPConnections then _G.ESPConnections = {} end

      local function cleanupConnections()
         for _, conn in pairs(_G.ESPConnections) do
            if conn then conn:Disconnect() end
         end
         _G.ESPConnections = {}
      end

      -- Fungsi memasang ESP
      local function applyESP(obj)
         if not targetNames[obj.Name] then return end
         
         -- KHUSUS AKARI & AKARINM (Box ESP)
         if obj.Name == "Akari" or obj.Name == "AkariNM" then
            if not obj:FindFirstChild("EnemyBoxESP") then
               local mainPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
               if mainPart then
                  local box = Instance.new("BoxHandleAdornment")
                  box.Name = "EnemyBoxESP"
                  box.Size = obj:IsA("Model") and (obj:GetExtentsSize() + Vector3.new(0.2, 0.2, 0.2)) or (mainPart.Size + Vector3.new(0.2, 0.2, 0.2))
                  box.Color3 = Color3.fromRGB(255, 0, 0)
                  box.Transparency = 0.6
                  box.AlwaysOnTop = true
                  box.ZIndex = 10
                  box.Adornee = mainPart
                  box.Parent = obj

                  local selectionBox = Instance.new("SelectionBox")
                  selectionBox.Name = "EnemyBoxOutline"
                  selectionBox.Color3 = Color3.fromRGB(255, 255, 255)
                  selectionBox.LineThickness = 0.05
                  selectionBox.Adornee = mainPart
                  selectionBox.Parent = box
               end
            end
         -- UNTUK MUSUH LAINNYA (Highlight)
         else
            if not obj:FindFirstChild("EnemyHighlight") then
               local highlight = Instance.new("Highlight")
               highlight.Name = "EnemyHighlight"
               highlight.FillColor = Color3.fromRGB(255, 0, 0)
               highlight.FillTransparency = 0.5
               highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
               highlight.OutlineTransparency = 0
               highlight.Parent = obj

               task.spawn(function()
                  while _G.GataGruntsESP and highlight and highlight.Parent do
                     if highlight.FillTransparency ~= 0.5 or highlight.OutlineTransparency ~= 0 then
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                     end
                     task.wait(0.5)
                  end
               end)
            end
         end
      end

      -- Fungsi hapus ESP
      local function removeESP()
         cleanupConnections()
         for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EnemyHighlight" or v.Name == "EnemyBoxESP" then
               v:Destroy()
            end
         end
      end

      -- Fungsi mengawasi folder dengan aman dan menunggu jika folder belum ada
      local function watchFolder(parentPath, folderName)
         task.spawn(function()
            local folder = parentPath:WaitForChild(folderName, 5) 
            if not folder then return end
            
            -- Scan musuh yang sudah ada di dalam folder saat ini
            for _, child in pairs(folder:GetChildren()) do
               applyESP(child)
            end
            
            -- Deteksi otomatis saat musuh baru masuk ke folder
            local conn = folder.ChildAdded:Connect(function(child)
               task.wait(0.1)
               if _G.GataGruntsESP then
                  applyESP(child)
               end
            end)
            table.insert(_G.ESPConnections, conn)
         end)
      end

      if _G.GataGruntsESP then
         -- SECTION 1
         local Section1 = workspace:FindFirstChild("Section1")
         if Section1 then watchFolder(Section1, "Grunts") end

         -- SECTION 2
         local Section2 = workspace:FindFirstChild("Section2")
         if Section2 then
            watchFolder(Section2, "Grunts")
            watchFolder(Section2, "Monster")
            watchFolder(Section2, "Rage")
            
            -- Jalur khusus MAINOBJECTIVE2 -> Spiders
            task.spawn(function()
               local MainObjective2 = Section2:WaitForChild("MAINOBJECTIVE2", 5)
               if MainObjective2 then
                  watchFolder(MainObjective2, "Spiders")
               end
            end)
            
            task.spawn(function()
               for i = 1, 3 do
                  local floor = Section2:WaitForChild("Floor" .. i, 5)
                  if floor then watchFolder(floor, "Monster") end
               end
            end)
         end

         -- SECTION 3
         local Section3 = workspace:FindFirstChild("Section3")
         if Section3 then
            watchFolder(Section3, "Monster")
            watchFolder(Section3, "SkillCheckMonster")
         end

         -- SECTION 4
         local Section4 = workspace:FindFirstChild("Section4")
         if Section4 then
            watchFolder(Section4, "Monster")
            watchFolder(Section4, "Monster2")
            watchFolder(Section4, "Monster3")
            watchFolder(Section4, "Monster4")
            watchFolder(Section4, "BossMonster")
            
            -- Jalur khusus Lab -> Floor1 -> Objective2 -> MukiSpawn (Muki & Muki2)
            task.spawn(function()
               local Lab = Section4:WaitForChild("Lab", 5)
               local Floor1 = Lab and Lab:WaitForChild("Floor1", 5)
               local Objective2 = Floor1 and Floor1:WaitForChild("Objective2", 5)
               if Objective2 then
                  watchFolder(Objective2, "MukiSpawn")
               end
            end)

            task.spawn(function()
               local WeakPoints = Section4:WaitForChild("WeakPoints", 5)
               if WeakPoints then watchFolder(WeakPoints, "Points") end
            end)
         end
      else
         removeESP()
      end
   end,
})

-- Toggle untuk Deteksi Jarak Musuh Spesifik (Versi Anti-Lag / Optimized)
local ToggleEnemyDistance = Tab:CreateToggle({
   Name = "Track Enemy Distance",
   CurrentValue = false,
   Flag = "EnemyDistanceTrackerFlag", 
   Callback = function(Value)
      _G.TrackEnemyDistance = Value

      local Players = game:GetService("Players")
      local RunService = game:GetService("RunService")
      local CoreGui = game:GetService("CoreGui")
      local localPlayer = Players.LocalPlayer

      -- Daftar hitam (Blacklist)
      local blacklistNames = {
         ["Gata"] = true, ["Gata2"] = true, ["Grunt1"] = true, 
         ["Grunt2"] = true, ["Grunt3"] = true, ["AkariSpider"] = true, 
         ["Muki"] = true, ["Muki2"] = true
      }

      -- Daftar putih (Whitelist)
      local whitelistNames = {
         ["AkariNM"] = true, ["AkariRage"] = true, ["Mizuno"] = true, 
         ["HogoGuntai"] = true, ["Baigai"] = true, ["AkariRageNM"] = true, 
         ["Kutsu"] = true, ["Senzai"] = true, ["MizunoNM"] = true, ["Akari"] = true
      }

      -- Tempat menyimpan objek musuh aktif (Cache)
      local activeEnemies = {}

      -- Fungsi mendeteksi & memasukkan objek valid ke cache
      local function checkAndCache(obj)
         if whitelistNames[obj.Name] and not blacklistNames[obj.Name] then
            local enemyPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
            if enemyPart then
               activeEnemies[obj] = enemyPart
               
               -- Jika objek dihapus dari game, buang dari cache
               obj.AncestryChanged:Connect(function(_, parent)
                  if not parent then
                     activeEnemies[obj] = nil
                  end
               end)
            end
         end
      end

      -- Bersihkan UI dan Koneksi Lama
      if CoreGui:FindFirstChild("EnemyDistanceGui") then CoreGui["EnemyDistanceGui"]:Destroy() end
      if _G.DistanceConnection then _G.DistanceConnection:Disconnect() _G.DistanceConnection = nil end
      if _G.DistanceInstanceConnection then _G.DistanceInstanceConnection:Disconnect() _G.DistanceInstanceConnection = nil end

      if _G.TrackEnemyDistance then
         -- Pembuatan UI
         local gui = Instance.new("ScreenGui")
         gui.Name = "EnemyDistanceGui"
         gui.ResetOnSpawn = false
         gui.Parent = CoreGui

         local textLabel = Instance.new("TextLabel")
         textLabel.Name = "DistanceLabel"
         textLabel.Size = UDim2.new(1, 0, 0, 150)
         textLabel.Position = UDim2.new(0, 0, 0, 40)
         textLabel.BackgroundTransparency = 1
         textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
         textLabel.TextSize = 18
         textLabel.Font = Enum.Font.SourceSansBold
         textLabel.TextStrokeTransparency = 0
         textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
         textLabel.TextYAlignment = Enum.TextYAlignment.Top
         textLabel.Text = "Scanning for targets..."
         textLabel.Parent = gui

         -- 1. Scan awal isi Workspace (Hanya berjalan SEKALI saat toggle aktif)
         for _, child in pairs(workspace:GetDescendants()) do
            checkAndCache(child)
         end

         -- 2. Pantau jika ada objek musuh baru yang muncul di game secara real-time
         _G.DistanceInstanceConnection = workspace.DescendantAdded:Connect(function(child)
            checkAndCache(child)
         end)

         -- 3. Loop Ringan RenderStepped (Hanya menghitung matematika jarak tanpa memindai ulang)
         _G.DistanceConnection = RunService.RenderStepped:Connect(function()
            if not _G.TrackEnemyDistance or not textLabel then 
               if _G.DistanceConnection then _G.DistanceConnection:Disconnect() end
               return 
            end

            local character = localPlayer.Character
            local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
            
            if not rootPart then
               textLabel.Text = "[Distance Tracker] Waiting for character..."
               return
            end

            local infoText = ""
            local foundTarget = false

            -- Loop hanya memutar isi tabel cache (Sangat ringan!)
            for obj, enemyPart in pairs(activeEnemies) do
               if enemyPart and enemyPart.Parent then
                  local distance = (rootPart.Position - enemyPart.Position).Magnitude
                  infoText = infoText .. string.format("%s: %.1f studs\n", obj.Name, distance)
                  foundTarget = true
               else
                  activeEnemies[obj] = nil -- Bersihkan jika part rusak/hilang
               end
            end

            if foundTarget then
               textLabel.Text = infoText
            else
               textLabel.Text = "No target enemies nearby."
            end
         end)
      end
   end,
})

