   Name = "Teleport Vertikal (+ Lantai Tetap)",
   CurrentValue = "",
   PlaceholderText = "Angka untuk TP / Kosongkan untuk hilangkan lantai",
   RemoveTextAfterFocusLost = false,
   Flag = "InstantTPPlatformInput",
   Callback = function(Text)
      local character = LocalPlayer.Character
      local hrp = character and character:FindFirstChild("HumanoidRootPart")
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      
      if not hrp or not humanoid then return end
      
      -- JIKA INPUT KOSONG -> MATIKAN TOTAL DAN BERSIHKAN SEMUANYA
      if Text == "" or Text == nil then
         MatikanScriptTotal(humanoid)
         return
      end
      
      -- JIKA INPUT BERUPA ANGKA (Teleport)
      local Angka = tonumber(Text)
      if Angka then
         -- Bersihkan dlu sisa loop sebelumnya sebelum membuat loop baru
         MatikanScriptTotal(humanoid)
         
         humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
         humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
         humanoid:ChangeState(Enum.HumanoidStateType.Running)
         
         _G.TPTargetY = (hrp.Position.Y + Angka) - 3.5
         hrp.CFrame = hrp.CFrame + Vector3.new(0, Angka, 0)
         
         _G.TPPlatform = Instance.new("Part")
         _G.TPPlatform.Name = "InvisibleTPFloor"
         _G.TPPlatform.Size = Vector3.new(8, 0.5, 8)
         _G.TPPlatform.Anchored = true
         _G.TPPlatform.CanCollide = true
         _G.TPPlatform.Transparency = 1
         _G.TPPlatform.Parent = workspace
         
         -- Jalankan loop baru dan simpan di global table (_G)
         _G.TPConnection = RunService.RenderStepped:Connect(function()
            -- Proteksi: Jika tiba-tiba objek dihapus di tengah jalan, loop otomatis berhenti sendiri
            if not _G.TPConnection then return end 
            
            if _G.TPPlatform and hrp and humanoid then
               _G.TPPlatform.CFrame = CFrame.new(hrp.Position.X, _G.TPTargetY, hrp.Position.Z)
               hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
               
               if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
                  humanoid:ChangeState(Enum.HumanoidStateType.Running)
               end
            else
               -- Jika salah satu object hilang (misal mati/reset), matikan loop-nya
               MatikanScriptTotal(humanoid)
            end
         end)
      end
   end
})

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- Menyimpan pengaturan asli game agar bisa dikembalikan saat toggle OFF
local OriginalAmbient = Lighting.Ambient
local OriginalOutdoorAmbient = Lighting.OutdoorAmbient
local OriginalClockTime = Lighting.ClockTime
local OriginalFogStart = Lighting.FogStart
local OriginalFogEnd = Lighting.FogEnd

local FullbrightConnection = nil

local Toggle = Tab:CreateToggle({
   Name = "Fullbright & No Fog",
   CurrentValue = false,
   Flag = "FullbrightNoFogToggle", -- Flag unik agar tidak bentrok
   Callback = function(Value)
      if Value then
         -- [ AKTIFKAN FULLBRIGHT & NO FOG ]
         -- Loop dijalankan terus-menerus agar game tidak bisa memaksa gelap kembali
         FullbrightConnection = RunService.RenderStepped:Connect(function()
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.ClockTime = 14
            
            -- Menghilangkan Kabut (Fog)
            Lighting.FogStart = 9e9
            Lighting.FogEnd = 9e9
            
            -- Menghilangkan efek kabut modern (Atmosphere) jika ada di game tersebut
            local Atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
            if Atmosphere then
               Atmosphere.Density = 0
            end
         end)
      else
         -- [ MATIKAN & KEMBALIKAN KE NORMAL ]
         if FullbrightConnection then
            FullbrightConnection:Disconnect()
            FullbrightConnection = nil
         end
         
         -- Kembalikan settingan pencahayaan asli bawaan game
         Lighting.Ambient = OriginalAmbient
         Lighting.OutdoorAmbient = OriginalOutdoorAmbient
         Lighting.ClockTime = OriginalClockTime
         Lighting.FogStart = OriginalFogStart
         Lighting.FogEnd = OriginalFogEnd
         
         local Atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
         if Atmosphere then
            Atmosphere.Density = 0.3 -- Nilai rata-rata density atmosphere normal game
         end
      end
   end,
})
