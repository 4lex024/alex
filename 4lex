local ToggleFly = Tab:CreateToggle({
   Name = "Fly Platform (Fix Kamera + E/Q)",
   CurrentValue = false,
   Flag = "FlyPlatformToggleEQFix", 
   Callback = function(Value)
      local character = Player.Character
      local hrp = character and character:FindFirstChild("HumanoidRootPart")
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      
      -- Bersihkan sisa platform/koneksi lama terlebih dahulu (Penting!)
      if TPConnection then TPConnection:Disconnect() TPConnection = nil end
      if TPPlatform then pcall(function() TPPlatform:Destroy() end) TPPlatform = nil end
      
      if not Value then
         if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
         end
         return
      end
      
      if not hrp or not humanoid then 
         Rayfield:Notify({Title = "Error", Content = "Karakter/HumanoidRootPart tidak ditemukan!", Duration = 3})
         return 
      end
      
      -- Setup State Karakter
      humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
      humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
      humanoid:ChangeState(Enum.HumanoidStateType.Running)
      
      TPTargetY = hrp.Position.Y - 3.5
      
      -- Membuat Platform Baru (Fix Typo .Value)
      local platform = Instance.new("Part")
      platform.Name = "InvisibleTPFloor"
      platform.Size = Vector3.new(8, 0.5, 8)
      platform.Anchored = true
      platform.CanCollide = true
      platform.Transparency = 1
      platform.Parent = workspace
      TPPlatform = platform -- Masukkan ke variabel global modul
      
      -- Loop Utama menggunakan RenderStepped yang Aman
      TPConnection = RunService.RenderStepped:Connect(function()
         -- Cek ulang apakah karakter dan platform masih eksis di setiap frame
         local currentChar = Player.Character
         local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
         local currentHumanoid = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
         
         if platform and platform.Parent and currentHrp and currentHumanoid and Camera then
            if IsPressingE then
               TPTargetY = TPTargetY + KecepatanTombol
            elseif IsPressingQ then
               TPTargetY = TPTargetY - KecepatanTombol
            elseif currentHumanoid.MoveDirection.Magnitude > 0 then
               local ArahKameraY = Camera.CFrame.LookVector.Y
               local ArahJalanKarakter = currentHumanoid.MoveDirection:Dot(Camera.CFrame.LookVector)
               local MultiplierArah = ArahJalanKarakter > 0 and 1 or (ArahJalanKarakter < 0 and -1 or 0)
               TPTargetY = TPTargetY + (ArahKameraY * SensitivitasKamera * MultiplierArah)
            end
            
            -- Update Posisi
            platform.CFrame = CFrame.new(currentHrp.Position.X, TPTargetY, currentHrp.Position.Z)
            currentHrp.CFrame = CFrame.new(currentHrp.Position.X, TPTargetY + 3.5, currentHrp.Position.Z)
            currentHrp.Velocity = Vector3.new(currentHrp.Velocity.X, 0, currentHrp.Velocity.Z)
            
            if currentHumanoid:GetState() ~= Enum.HumanoidStateType.Running then
               currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
         else
            -- Jika karakter mati atau platform hilang, matikan koneksi otomatis
            if TPConnection then TPConnection:Disconnect() TPConnection = nil end
         end
      end)
   end,
})

