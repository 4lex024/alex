-- ESP Enemies
local GataGruntsESP = false
local ESPConnections = {}
local targetNames = {
   ["Gata"] = true, ["Gata2"] = true, ["Grunt1"] = true, ["Grunt2"] = true, ["Grunt3"] = true,
   ["AkariNM"] = true, ["AkariSpider"] = true, ["AkariRage"] = true, ["Mizuno"] = true,
   ["Muki"] = true, ["Muki2"] = true, ["HogoGuntai"] = true, ["Baigai"] = true,
   ["AkariRageNM"] = true, ["MizunoNM"] = true, ["Akari"] = true,
   ["Tenome"] = true, ["Rin"] = true, ["Tsukiya"] = true, ["Senzai"] = true, ["Kutsu"] = true,
   ["Enzukai2"] = true, ["Rin2"] = true, ["Tenome2"] = true, ["Tsukiya2"] = true,
   ["EnzukaiRyu"] = true, ["EnzukaiWeakPoint"] = true
}

local function applyEnemyESP(obj)
   if not GataGruntsESP or not targetNames[obj.Name] then return end
   if obj.Name == "Akari" or obj.Name == "AkariNM" then
      if not obj:FindFirstChild("EnemyBoxESP") then
         local mainPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
         if mainPart then
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "EnemyBoxESP"
            box.Size = obj:IsA("Model") and (obj:GetExtentsSize() + Vector3.new(0.2, 0.2, 0.2)) or (mainPart.Size + Vector3.new(0.2, 0.2, 0.2))
            box.Color3 = Color3.fromRGB(255, 0, 0)
            box.Transparency = 0.6
            box.AlwaysOnTop = true
            box.Adornee = mainPart
            box.Parent = obj

            local selectionBox = Instance.new("SelectionBox")
            selectionBox.Name = "EnemyBoxOutline"
            selectionBox.Color3 = Color3.fromRGB(255, 255, 255)
            selectionBox.LineThickness = 0.05
            selectionBox.Adornee = mainPart
            selectionBox.Parent = box
         end
      end
   else
      if not obj:FindFirstChild("EnemyHighlight") then
         local highlight = Instance.new("Highlight")
         highlight.Name = "EnemyHighlight"
         highlight.FillColor = Color3.fromRGB(255, 0, 0)
         highlight.FillTransparency = 0.5
         highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
         highlight.Parent = obj
      end
   end
end

local ToggleEnemies = Tab:CreateToggle({
   Name = "ESP Enemies",
   CurrentValue = false,
   Flag = "GataGruntsESPFlag", 
   Callback = function(Value)
      GataGruntsESP = Value
      if Value then
         for _, v in pairs(workspace:GetDescendants()) do applyEnemyESP(v) end
         local conn = workspace.DescendantAdded:Connect(function(child)
            task.wait(0.1)
            applyEnemyESP(child)
         end)
         table.insert(ESPConnections, conn)
      else
         for _, conn in pairs(ESPConnections) do if conn then conn:Disconnect() end end
         ESPConnections = {}
         for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EnemyHighlight" or v.Name == "EnemyBoxESP" then v:Destroy() end
         end
      end
   end,
})

-- Track Enemy Distance (Optimized)
local TrackEnemyDistance = false
local DistanceConnection = nil
local DistanceInstanceConnection = nil
local activeEnemies = {}

local whitelistNames = {
   ["AkariNM"] = true, ["AkariRage"] = true, ["Mizuno"] = true, 
   ["HogoGuntai"] = true, ["Baigai"] = true, ["AkariRageNM"] = true, 
   ["Kutsu"] = true, ["Senzai"] = true, ["MizunoNM"] = true, ["Akari"] = true
}

local function checkAndCache(obj)
   if whitelistNames[obj.Name] then
      local enemyPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
      if enemyPart then
         activeEnemies[obj] = enemyPart
      end
   end
end

local ToggleDistance = Tab:CreateToggle({
   Name = "Track Enemy Distance",
   CurrentValue = false,
   Flag = "EnemyDistanceTrackerFlag", 
   Callback = function(Value)
      TrackEnemyDistance = Value
      if CoreGui:FindFirstChild("EnemyDistanceGui") then CoreGui["EnemyDistanceGui"]:Destroy() end
      if DistanceConnection then DistanceConnection:Disconnect() DistanceConnection = nil end
      if DistanceInstanceConnection then DistanceInstanceConnection:Disconnect() DistanceInstanceConnection = nil end

      if TrackEnemyDistance then
         local gui = Instance.new("ScreenGui", CoreGui)
         gui.Name = "EnemyDistanceGui"
         
         local textLabel = Instance.new("TextLabel", gui)
         textLabel.Size = UDim2.new(1, 0, 0, 150)
         textLabel.Position = UDim2.new(0, 0, 0, 40)
         textLabel.BackgroundTransparency = 1
         textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
         textLabel.TextSize = 18
         textLabel.Font = Enum.Font.SourceSansBold
         textLabel.TextStrokeTransparency = 0
         textLabel.TextYAlignment = Enum.TextYAlignment.Top
         textLabel.Text = "Scanning..."

         table.clear(activeEnemies)
         for _, child in pairs(workspace:GetDescendants()) do checkAndCache(child) end
         DistanceInstanceConnection = workspace.DescendantAdded:Connect(checkAndCache)

         DistanceConnection = RunService.Heartbeat:Connect(function()
            local character = Player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if not rootPart then textLabel.Text = "Waiting for character..." return end

            local infoText = ""
            local found = false
            for obj, enemyPart in pairs(activeEnemies) do
               if enemyPart and enemyPart.Parent then
                  local distance = (rootPart.Position - enemyPart.Position).Magnitude
                  infoText = infoText .. string.format("%s: %.1f studs\n", obj.Name, distance)
                  found = true
               else
                  activeEnemies[obj] = nil
               end
            end
            textLabel.Text = found and infoText or "No target enemies nearby."
         end)
      end
   end,
})

