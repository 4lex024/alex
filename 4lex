-- Pengaturan Kecepatan
local SensitivitasKamera = 0.5 -- Kecepatan naik/turun lewat arah kamera
local KecepatanTombol = 0.75   -- Kecepatan naik/turun saat menekan E / Q

-- Variabel untuk mengecek status tombol yang sedang ditekan
local IsPressingE = false
local IsPressingQ = false

-- Fungsi Sakral untuk Mematikan dan Membersihkan Semuanya Sampai Akar
local function MatikanScriptTotal(humanoid)
   if _G.TPConnection then
      _G.TPConnection:Disconnect()
      _G.TPConnection = nil
   end
   
   if _G.TPPlatform then
      _G.TPPlatform:Destroy()
      _G.TPPlatform = nil
   end
   
   if humanoid then
      humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
      humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
      humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
   end
end

