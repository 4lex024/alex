                       -- Pembersihan otomatis jika item hilang/diambil
                       for oldItem, tag in pairs(activeTags) do
                           if not oldItem or not oldItem.Parent then
                               if tag then tag:Destroy() end
                               activeTags[oldItem] = nil
                           end
                       end
                   end
                   task.wait(0.1) -- Loop cepat 100ms agar responsif saat player berjalan cepat antar rumah
               end
           end)
       else
           print("[ESP] Mematikan ESP.")
           removeAllESP()
       end
   end,
})
