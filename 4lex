      if CoreGui:FindFirstChild("EnemyDistanceGui") then CoreGui["EnemyDistanceGui"]:Destroy() end
      if DistanceConnection then DistanceConnection:Disconnect() DistanceConnection = nil end
      if DistanceInstanceConnection then DistanceInstanceConnection:Disconnect() DistanceInstanceConnection = nil end

      if TrackEnemyDistance then
         local gui = Instance.new("ScreenGui", CoreGui)
         gui.Name = "EnemyDistanceGui"
         
         local textLabel = Instance.new("TextLabel", gui)
         textLabel.Size = UDim2.new(1, 0, 0, 150)
